{
  "name": "foamcut-simulator-ua-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "portable": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "ua.foamcut.simulator",
    "productName": "FoamCut Simulator UA",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "FoamCut-Simulator-UA-${version}-portable.${ext}"
    }
  }
}
